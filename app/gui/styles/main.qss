/* ====== Transformation title label ====== */
#transformationsTitle {
    font-weight: bold;
    font-size: 17pt;
}

/* ====== Scroll area ====== */
#imageScrollArea {
    border: 0.05em solid #555;
    border-radius: 0.1em;
    color: #aaa;
}

/* ====== Image info panel ====== */
#imageInfoPanel {
    border: 0.05em solid #555;
    border-radius: 0.1em;
}

#imageInfoTitle {
    font-weight: bold;
    color: #ddd;
}

#imageInfoValue {
    color: #eee;
}

/* ====== General operation control widget ====== */
#operationControl {
    border: 0.05em solid #555;
    border-radius: 0.1em;
    margin-top: 0.5em;
}

#operationControlTitle {
    font-weight: bold;
    font-size: 10.5pt;
    text-decoration: underline;
    margin-bottom: 0.3em;
}

#operationControlInfo {
    font-size: 9pt;
    color: #bbb;
    font-style: italic;
}

/* ====== Collapsible sections ====== */
#collapsibleHeader {
    font-size: 11.5pt;
    background-color: #636363;
    border: 0.05em solid #555;
    border-radius: 0.1em;
    padding: 0.1em 0.15em;
    margin-top: 0.5em;
    color: #ddd;
    font-weight: 600;
    text-align: left;
}

#collapsibleHeader:hover {
    background-color: #5f6264;
}

#collapsibleHeader:checked {
    background-color: #636363;
}

/* ====== Operation pipeline ====== */
#operationPipelineTitle {
    font-weight: bold;
    color: #ddd;
    margin-bottom: 0.3em;
}

#operationPipelineList {
    background-color: #151515;
    color: #e0e0e0;
    border: 0.05em solid #555;
    border-radius: 0.15em;
    padding: 0.25em;
}

#operationPipelineList::item {
    padding: 0.35em;
}

#operationPipelineList::item:selected {
    background-color: #3f4449;
}

/* ====== Operation controls placeholder ====== */
#operationControlsTitle {
    font-weight: bold;
    font-size: 13pt;
    color: #ddd;
}

#operationControlsLayout {
    border: 0.05em solid #555;
    border-radius: 0.1em;
}

#operationControlPlaceholderText {
    color: #b5b5b5;
    font-style: italic;
}

/* ====== Info logger tabs ====== */
#infoLoggerTabs {
    border: 0.05em solid #555;
    border-radius: 0.1em;
}

#infoLoggerTabs::pane {
    border: none;
}

#infoLoggerTabs QTabBar::tab {
    background-color: #3a3f44;
    padding: 0.15em 0.6em;
    border: 0.05em solid #555;
    border-bottom: none;
    border-top-left-radius: 0.2em;
    border-top-right-radius: 0.2em;
    color: #ccc;
}

#infoLoggerTabs QTabBar::tab:selected {
    background-color: #4c5258;
    color: #f0f0f0;
}

#generalLogger {
    background-color: #151515;
    color: #e0e0e0;
    border: 0.05em solid #555;
    padding: 0.4em;
}

#operationButton {
    font-size: 12pt;
    width: 30px; 
    height: 18px;
    margin: 0.2em 0em 0em 0.15em;
}

#deviceButton {
    font-size: 12pt;
    width: 30px; 
    height: 18px;
    margin: 0.2em 0em 0em 0.15em;
}

/* ====== Global ====== */
QWidget {
    background-color: #2b2b2b;
    font-family: Segoe UI;
    color: #ddd;
    font-size: 10.5pt;
}

/* ====== Buttons ====== */
QPushButton {
    background-color: #3a3f44;
    border: 0.05em solid #555;
    border-radius: 0.1em;
    padding: 0.25em;
    color: #ddd;
}

QPushButton:hover {
    background-color: #50565c;
}

QPushButton:pressed {
    background-color: #2e3236;
}

QPushButton:disabled {
    background-color: #555;
    color: #888;
}

QToolButton::menu-indicator {
    image: none;
}

/* ====== Numeric spin boxes ====== */
QDoubleSpinBox {
    background-color: #3a3f44;
    padding: 0.05em;
    color: #ddd;
}

QSpinBox {
    background-color: #3a3f44;
    padding: 0.05em;
    color: #ddd;
}

/* ====== Labels ====== */
QLabel {
    color: #ccc;
}

/* ====== Combo boxes ====== */
QComboBox {
    background-color: #3a3f44;
    margin-bottom: 0.25em;
    padding: 0.3em;
    color: #ddd;
}

QComboBox QAbstractItemView {
    border: 0.05em solid #555;
    border-radius: 0.1em;
}

/* ====== QMenu ====== */
QMenu {
    background-color: #3a3f44;
    border: 0.05em solid #555;
    border-radius: 0.1em;
    color: #ddd;
}

QMenu::item {
    padding: 0.3em 1em;
}

QMenu::item:selected {
    background-color: #50565c;
}

/* ====== Scrollbars ====== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
}

QScrollBar::handle:vertical {
    background-color: #5a5f66;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6c7178;
}

QScrollBar::handle:vertical:pressed {
    background-color: #4b4f55;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: rgba(0, 0, 0, 0);
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 4px 2px 4px;
}

QScrollBar::handle:horizontal {
    background-color: #5a5f66;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6c7178;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #4b4f55;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: rgba(0, 0, 0, 0);
}
