/* ====== Global ====== */
QWidget {
    background-color: #2b2b2b;
    font-family: Segoe UI;
    color: #ddd;
    font-size: 10.5pt;
}

/* ====== Buttons ====== */
QPushButton {
    background-color: #3a3f44;
    border: 0.05em solid #555;
    border-radius: 0.25em;
    padding: 0.35em;
    color: #ddd;
}

QPushButton:hover {
    background-color: #50565c;
}

QPushButton:pressed {
    background-color: #2e3236;
}

QPushButton:disabled {
    background-color: #555;
    color: #888;
}

/* ====== Labels ====== */
QLabel {
    color: #ccc;
}

/* ====== Combo boxes ====== */
QComboBox {
    background-color: #3a3f44;
    margin-bottom: 0.25em;
    padding: 0.3em;
    color: #ddd;
}

QComboBox QAbstractItemView {
    border: 0.05em solid #555;
    border-radius: 0.25em;
}

/* ====== Transformation title label ====== */
#transformationsTitle {
    font-weight: bold;
    font-size: 17pt;
}

/* ====== Scroll area ====== */
#imageScrollArea {
    border: 0.05em solid #555;
    border-radius: 0.25em;
    color: #aaa;
}

/* ====== Image info panel ====== */
#imageInfoPanel {
    border: 0.05em solid #555;
    border-radius: 0.25em;
    margin-bottom: 0.6em;
}

#imageInfoTitle {
    font-weight: bold;
    color: #ddd;
}

#imageInfoValue {
    color: #eee;
}

/* ====== General operation control widget ====== */
#operationControl {
    border: 0.05em solid #555;
    border-radius: 0.25em;
    margin-top: 0.5em;
}

#operationControlTitle {
    font-weight: bold;
    font-size: 11pt;
    margin-bottom: 0.3em;
}

/* ====== Collapsible sections ====== */
#collapsibleHeader {
    font-size: 12pt;
    background-color: #636363;
    border: 0.05em solid #555;
    border-radius: 0.25em;
    padding: 0.2em 0.25em;
    margin-top: 0.5em;
    color: #ddd;
    font-weight: 600;
    text-align: left;
}

#collapsibleHeader:hover {
    background-color: #5f6264;
}

#collapsibleHeader:checked {
    background-color: #636363;
}

QToolButton::menu-indicator {
    image: none;
}

/* ====== Numeric spin boxes ====== */
QDoubleSpinBox {
    background-color: #3a3f44;
    padding: 0.15em;
    color: #ddd;
}

QSpinBox {
    background-color: #3a3f44;
    padding: 0.15em;
    color: #ddd;
}

/* ====== Operation history ====== */
#operationHistoryPanel {
    border: 0.05em solid #555;
    border-radius: 0.25em;
    margin-top: 0.5em;
}

#operationHistoryTitle {
    font-weight: bold;
    color: #ddd;
}

#operationHistoryText {
    background-color: #151515;
    color: #E0E0E0;
    border: 0.05em solid #333;
}