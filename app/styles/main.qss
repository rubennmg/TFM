/* ====== Global ====== */
QWidget {
    background-color: #2b2b2b;
    font-family: Segoe UI;
    color: #ddd;
    font-size: 10.5pt;
}

/* ====== Buttons ====== */
QPushButton {
    background-color: #3a3f44;
    border: 0.05em solid #555;
    border-radius: 0.25em;
    padding: 0.35em;
    color: #ddd;
}

QPushButton:hover {
    background-color: #50565c;
}

QPushButton:pressed {
    background-color: #2e3236;
}

QPushButton:disabled {
    background-color: #555;
    color: #888;
}

/* ====== Labels ====== */
QLabel {
    color: #ccc;
}

/* ====== Combo boxes ====== */
QComboBox {
    background-color: #3a3f44;
    margin-bottom: 0.25em;
    padding: 0.3em;
    color: #ddd;
}

QComboBox QAbstractItemView {
    border: 0.05em solid #555;
    border-radius: 0.25em;
}

/* ====== Transformation title label ====== */
#transformationsTitle {
    font-weight: bold;
    font-size: 12pt;
    margin-bottom: 0.5em;
}

/* ====== Scroll area ====== */
#imageScrollArea {
    border: 0.05em solid #555;
    border-radius: 0.25em;
    color: #aaa;
}

/* ====== Image info panel ====== */
#imageInfoPanel {
    border: 0.05em solid #555;
    border-radius: 0.25em;
    margin-bottom: 0.6em;
}

#imageInfoTitle {
    font-weight: bold;
    color: #ddd;
}

#imageInfoValue {
    color: #eee;
}

/* ====== Debayer Control ====== */
#debayerControl {
    border: 0.05em solid #555;
    border-radius: 0.25em;
}

#debayerControlTitle {
    font-weight: bold;
    font-size: 11pt;
    margin-bottom: 0.3em;
}

/* ====== Filter control widget ====== */
#filterControl {
    border: 0.05em solid #555;
    border-radius: 0.25em;
    margin-bottom: 0.8em;
}

/* ====== Filter control title label ====== */
#filterControlTitle {
    font-weight: bold;
    font-size: 11pt;
    margin-bottom: 0.3em;
}
