% Custom Equation List
% ----------------------------------------
\newcommand{\listequationsname}{\textbf{Índice de ecuaciones}}
\newlistof{myequations}{equ}{\listequationsname}
\cftsetindents{myequations}{1.5em}{2.25em}
\makeatletter
\renewcommand{\listofmyequations}{%
  {\section*{\Large \listequationsname}%
   \@starttoc{equ}}%
}
\makeatother
\newcommand{\myequations}[1]{%
\addcontentsline{equ}{myequations}{\protect\numberline{\theequation}#1}\par}

\DeclareFloatingEnvironment[
    fileext=loe,
    listname=\listequationsname,
    name=Ecuación,
    placement=tbhp
]{myequation}
\captionsetup[myequation]{skip=0pt}

